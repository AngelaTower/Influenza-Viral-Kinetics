# SUMMARY STATISTICS of Effector cell Populations
# (1) (Median) Expansion Rate: how fast the effector population is doubling before peak  (1/Day)
# log transformed: (ln(Epeak)-ln(Estart))/(tpeak - tstart)
# (2) (Median) Peak Effector population: Highest concentration of effector T cells simulated measured during the infection for low vs. high shedders (Total Cells)
# (3) (Median) Time to Peak: measure the kinetics or speed of the response - when effector is at maximum (Day)
# (4) (Median) AUC: Total immune exposure (until the peak, before the plateau?) (cells x Days)
#--------------------------------------------------------------- #  

# Determine the four summary trajectories: (1)expansion rate, (2)peak effector, (3)peak time, (4)AUC
```{r Calculate effector Cell Summary individual}
#####################################################################
#define function to calculate the four summaries
#####################################################################
calc_individual_stats <- combined_output %>%
  group_by(ID, group) %>%
  summarise(
    # determine peak effector cells
    PeakSize    = max(effector_plot, na.rm = TRUE), 
    
    # determine time to peak
    TimeToPeak  = time[which.max(effector_plot)],
    
    # determine AUC using trapezoidal rule
    AUC         = pracma::trapz(time, effector_plot),
    
    # Determine expansion rate
    ExpRate = {
      # Find first positive value
      pos_idx <- which(effector_plot > 0)
      if(length(pos_idx) >= 2) {
        first_idx <- pos_idx[1]
        peak_idx <- which.max(effector_plot)
        if(peak_idx > first_idx && time[peak_idx] > time[first_idx]) {
          (effector_plot[peak_idx] - effector_plot[first_idx]) / 
            (time[peak_idx] - time[first_idx])
        } else {
          NA
        }
      } else {
        NA
      }
    },
    .groups = 'drop'
  )

print(head(calc_individual_stats, 10))

