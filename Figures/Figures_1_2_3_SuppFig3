## ODE Model 4: Simulating with and WITHOUT immune responses to compare the viral kinetics across individuals
## Speculations that the viral dynamics should be the same and the contributing differences come from the immune components within model
```{r Model4: ODE System}
# -----------------------------------------#
# Viral Dynamics Model for simulation
# -----------------------------------------#
teirv_model <- function(time, state, parameters){
  with(as.list(c(state, parameters)),{
    ddt_T  = -beta*T*V - phi*Ip*T + eta*R
    ddt_Ie = beta*T*V - gamma*Ie               
    ddt_Ip = gamma*Ie - delta*Ip - k*Ip*E  
    ddt_R  = phi*Ip*T - eta*R
    #ddt_V  = p*Ip - c*V
    ddt_V  = pi*Ip - c*V
    ddt_E  = theta*E*Ip^h/(Ip^h+r^h)        # Hill Coefficient (h)

    return(list(c(
      dT  = ddt_T,
      dIe = ddt_Ie,
      dIp = ddt_Ip,
      dR  = ddt_R,
      dV  = ddt_V,
      dE  = ddt_E
    )))
  })
}
