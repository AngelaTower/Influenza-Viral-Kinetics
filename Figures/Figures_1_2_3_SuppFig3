## Facet all simulated plots with EFFECTOR params SET to 0 together
## Simulating the viral dynamics without adaptive immune response 
```{r Faceted plots with effector parameters = 0}
#--------------------------------------------------------------- #
# Categorize the plots: Natural/numeric order with number first, then letter
# This handles cases like "4A", "12A", "18A", "30A", "33A"...
#--------------------------------------------------------------- #
if(all(grepl("^[0-9]+[A-Za-z]+$", unique(combined_output_no_effector$ID)))) {
  # Extract number and letter parts (number comes first in ID)
  id_parts <- data.frame(
    ID = unique(combined_output_no_effector$ID),
    numbers = as.numeric(gsub("[A-Za-z]+$", "", unique(combined_output_no_effector$ID))),
    letters = gsub("^[0-9]+", "", unique(combined_output_no_effector$ID))
  ) %>%
    arrange(numbers, letters)  # Sort by number first, then letter
  
  # FIXED: Use the ordered id_parts$ID, not sort()
  combined_output_no_effector$ID_natural <- factor(combined_output_no_effector$ID, levels = id_parts$ID)
  
} else if(all(grepl("^[A-Za-z]+[0-9]+$", unique(combined_output_no_effector$ID)))) {
  # Handle cases like P1, P2, P10 (letter first, then number)
  id_parts <- data.frame(
    ID = unique(combined_output_no_effector$ID),
    letters = gsub("[0-9]+$", "", unique(combined_output_no_effector$ID)),
    numbers = as.numeric(gsub("^[A-Za-z]+", "", unique(combined_output_no_effector$ID)))
  ) %>%
    arrange(letters, numbers)
  
  # FIXED: Use the ordered id_parts$ID, not sort()
  combined_output_no_effector$ID_natural <- factor(combined_output_no_effector$ID, levels = id_parts$ID)
  
} else {
  # Fallback to alphabetical if pattern doesn't match
  combined_output_no_effector$ID_natural <- factor(combined_output_no_effector$ID, levels = sort(unique(combined_output_no_effector$ID)))
}

# Set the ordering
combined_output_no_effector$ID_ordered <- combined_output_no_effector$ID_natural

