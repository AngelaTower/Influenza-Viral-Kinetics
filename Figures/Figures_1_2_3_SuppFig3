```{r Normality test}
# Shapiro-Wilk normality test for each group: tests whether the data significantly deviates from a normal (Guassian) distribution. 
# Group name: "Low-shedder", "High-shedder"
shapiro_test_group1 <- shapiro.test(combined_output$E[combined_output$group == "Low-shedder"])
shapiro_test_group2 <- shapiro.test(combined_output$E[combined_output$group == "High-shedder"])

# Print the results of the normality tests
shapiro_test_group1      
shapiro_test_group2
# Result: less than 0.05: reject the null hypothesis; data is not normally distributed

# Mann-Whitney U/Wilcoxon rank-sum Test (since data is not normally distributed, by the above shapiro-test result)
wilcoxon_test_result <- wilcox.test(combined_output$E ~ group, data = combined_output)

p_value <- wilcoxon_test_result$p.value
p_value
# Result: p-value = 4.546e-10 < 0.05. Thus, there is a significant difference between the two groups: low vs high shedder E-compartment
# This p-value is different from the box-plot of E0 p-value since that was comparing the individual estimates 

# Using Wilcoxon rank-sum test at each time point by point between the two groups to see if there is any statistical significance
compare_results <- combined_output %>%
  group_by(time) %>%
  summarize(p_value = wilcox.test(E ~ group)$p.value) %>%
  mutate(sig = case_when(
    #p_value < 0.001 ~ "***",
    #p_value < 0.01  ~ "**",
    p_value < 0.05  ~ "*"
    #TRUE            ~ "ns"
  ))

compare_vl_results <- combined_output %>%
